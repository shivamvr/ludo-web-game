{
  "rules": {
    ".read": false,
    ".write": false,

    "rooms": {
      "$roomId": {
        // Readable by anyone signed in while the room is open to joiners —
        // before the first game and again between games — and while a game is
        // being played only by the people sitting at it. A room that does not
        // exist reads as null rather than as a permission error, so entering a
        // wrong code shows "no such room" instead of a scary failure.
        ".read": "auth != null && (!data.exists() || data.child('status').val() !== 'playing' || data.child('players').hasChild(auth.uid))",

        // Create a room by seating yourself as host, or write to a room you are
        // already in. A room that is not mid-game also accepts the write from
        // someone who is joining it in that same write, which is what keeps one
        // invite link working for game after game.
        ".write": "auth != null && ((!data.exists() && newData.child('hostId').val() === auth.uid && newData.child('status').val() === 'waiting') || (data.exists() && (data.child('players').hasChild(auth.uid) || (data.child('status').val() !== 'playing' && newData.child('players').hasChild(auth.uid)))))",

        ".validate": "newData.hasChildren(['hostId', 'status', 'players', 'createdAt'])",

        "hostId": {
          ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())"
        },

        "createdAt": {
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"
        },

        // Tokens each player gets. Set when the room is created and fixed while
        // it is in use — the game state is built from it, so letting it move
        // mid-room would put the board and the seats out of step. The host may
        // change it once a game has finished, which is what a rematch on new
        // rules is.
        "tokenCount": {
          ".validate": "newData.isNumber() && newData.val() >= 4 && newData.val() <= 8 && newData.val() % 1 === 0 && (!data.exists() || newData.val() === data.val() || (data.parent().child('status').val() === 'finished' && data.parent().child('hostId').val() === auth.uid))"
        },

        // Which numbers bring a token out of the yard. Fixed for the same
        // reason and freed at the same moment: both clients resolve moves from
        // it, so it cannot move once anyone has rolled.
        "yardExit": {
          ".validate": "newData.isString() && newData.val().matches(/^(six|one-or-six)$/) && (!data.exists() || newData.val() === data.val() || (data.parent().child('status').val() === 'finished' && data.parent().child('hostId').val() === auth.uid))"
        },

        // Only the host may start a game, first one or rematch. Anyone at the
        // table may finish one — the winning move and the abandonment watchdog
        // both need to.
        "status": {
          ".validate": "newData.isString() && newData.val().matches(/^(waiting|playing|finished)$/) && (!data.exists() || newData.val() === data.val() || ((data.val() === 'waiting' || data.val() === 'finished') && newData.val() === 'playing' && newData.parent().child('hostId').val() === auth.uid) || (data.val() === 'playing' && newData.val() === 'finished'))"
        },

        // The next game, put together on the win screen while the room sits
        // finished. Anyone at the table may answer for themselves; the rules
        // are the host's to set. The offer only exists between games, and
        // starting one clears it.
        "rematch": {
          ".validate": "newData.parent().child('status').val() === 'finished'",

          "tokenCount": {
            ".validate": "newData.isNumber() && newData.val() >= 4 && newData.val() <= 8 && newData.val() % 1 === 0 && (!data.exists() || newData.val() === data.val() || newData.parent().parent().child('hostId').val() === auth.uid)"
          },
          "yardExit": {
            ".validate": "newData.isString() && newData.val().matches(/^(six|one-or-six)$/) && (!data.exists() || newData.val() === data.val() || newData.parent().parent().child('hostId').val() === auth.uid)"
          },
          "votes": {
            "$voterUid": {
              ".validate": "newData.isString() && newData.val().matches(/^(in|out)$/) && ($voterUid === auth.uid || newData.val() === data.val())"
            }
          },
          "$other": { ".validate": false }
        },

        "endedReason": {
          ".validate": "newData.isString() && newData.val().matches(/^(won|abandoned)$/)"
        },

        "players": {
          "$playerUid": {
            ".validate": "newData.hasChildren(['name', 'color', 'joinedAt'])",

            // Your own seat is yours to edit; everyone else's fields must come
            // through a write unchanged.
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24 && ($playerUid === auth.uid || newData.val() === data.val())"
            },
            // Your colour is yours to change, but only in the lobby — once the
            // game is under way a seat's colour is what binds it to the board.
            // The host may also move a seat while the room is waiting, which is
            // what lets the start write put a two-player table on opposite
            // corners. `root` is the pre-write state, so a room being started in
            // this very write still reads as 'waiting' here.
            "color": {
              ".validate": "newData.isString() && newData.val().matches(/^(red|green|yellow|blue)$/) && (newData.val() === data.val() || (!data.exists() && $playerUid === auth.uid) || (root.child('rooms').child($roomId).child('status').val() === 'waiting' && ($playerUid === auth.uid || root.child('rooms').child($roomId).child('hostId').val() === auth.uid)))"
            },
            "joinedAt": {
              ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"
            },
            "connected": {
              ".validate": "newData.isBoolean() && ($playerUid === auth.uid || newData.val() === data.val())"
            },
            "disconnectedAt": {
              ".validate": "newData.isNumber() && ($playerUid === auth.uid || newData.val() === data.val())"
            },
            "$other": { ".validate": false }
          }
        },

        // Turn ownership, and the heart of these rules. A change to the game
        // state is only accepted from the player who held the turn in the
        // PREVIOUS state — or, when that player has dropped off the network,
        // from anyone else at the table, which is what lets the game play on
        // without them. Writes that leave the state untouched (version
        // unchanged) are allowed, so presence and status updates may carry the
        // whole room node.
        //
        // The last clause is the rematch: a finished room being set playing
        // again by its host replaces the state outright, so the version starts
        // over rather than climbing.
        "gameState": {
          ".validate": "newData.hasChildren(['players', 'turnIndex', 'phase', 'version']) && ((!data.exists() && newData.parent().child('hostId').val() === auth.uid) || newData.child('version').val() === data.child('version').val() || (data.parent().child('status').val() === 'playing' && newData.child('version').val() > data.child('version').val() && (data.child('players').child('' + data.child('turnIndex').val()).child('uid').val() === auth.uid || root.child('rooms').child($roomId).child('players').child('' + data.child('players').child('' + data.child('turnIndex').val()).child('uid').val()).child('connected').val() === false)) || (data.parent().child('status').val() === 'finished' && newData.parent().child('status').val() === 'playing' && newData.parent().child('hostId').val() === auth.uid))",

          "turnIndex": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3" },
          "version": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "phase": { ".validate": "newData.isString() && newData.val().matches(/^(awaiting-roll|awaiting-move|game-over)$/)" },
          "rngSeed": { ".validate": "newData.isNumber()" },

          // Both are lists: a six is held rather than played, so a turn carries
          // several numbers at once. There is no tight ceiling — an earned roll
          // is taken with numbers still in hand, and it can earn another — so
          // these only reject nonsense rather than pinning an exact length.
          "dice": {
            ".validate": "newData.hasChildren() && !newData.hasChild('64')",
            "$slot": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 6" }
          },
          "lastRoll": {
            ".validate": "newData.hasChildren() && !newData.hasChild('64')",
            "$slot": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 6" }
          },
          "consecutiveSixes": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2" },
          // Copied from the room when the game is built, and never rewritten
          // while that game is being played: changing it mid-game would change
          // which moves are legal. A rematch is a different game, so it may
          // arrive under different rules.
          "yardExit": {
            ".validate": "newData.isString() && newData.val().matches(/^(six|one-or-six)$/) && (!data.exists() || newData.val() === data.val() || data.parent().parent().child('status').val() === 'finished')"
          },
          // Extra rolls earned by capturing or by bringing a token home. These
          // queue across a turn, and an earned roll can earn more, so there is
          // no tight bound worth restating here — this only rejects nonsense.
          "bonusRolls": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 64" },

          "players": {
            "$seat": {
              ".validate": "newData.hasChildren(['color', 'tokens'])",
              "uid": { ".validate": "newData.isString()" },
              "color": { ".validate": "newData.isString() && newData.val().matches(/^(red|green|yellow|blue)$/)" },
              "tokens": {
                "$token": {
                  "progress": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 57" }
                }
              }
            }
          }
        },

        "$other": { ".validate": false }
      }
    }
  }
}
